# Application
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Local docker compose with NODE_ENV=production uses http://localhost — keep this true there only.
ALLOW_INSECURE_WEB_URL=false

# Database
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm?schema=public&sslmode=disable

# Supabase Auth — public values may be used by Next.js (baked into the web image at build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dev-change-me

# Supabase Auth — server only. Never prefix the service role or JWT secret with NEXT_PUBLIC_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=dev-change-me
SUPABASE_SERVICE_ROLE_KEY=

# Billing — server only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Optional public checkout keys (safe in the browser). Not required for redirect checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Invitations
INVITATION_TTL_DAYS=7
INVITATION_RESEND_COOLDOWN_SECONDS=60

# Tasks
TASK_REMINDER_HOURS=24

# Worker
WORKER_ID=local-1
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=10
WORKER_HEALTH_PORT=8081
JOB_POLL_INTERVAL=2s
JOB_BATCH_SIZE=20
JOB_LOCK_TIMEOUT=5m
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_DELAY=30s
JOB_MAX_BACKOFF=1h
JOB_RETRY_JITTER=5s
SHUTDOWN_TIMEOUT=25s
DB_MAX_OPEN_CONNECTIONS=10
DB_MAX_IDLE_CONNECTIONS=5
JOB_COMPLETED_RETENTION=336h
JOB_FAILED_RETENTION=2160h
TASK_REMIND_INTERVAL_MS=300000
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
