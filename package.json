{
  "name": "crm",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@crm/web",
    "dev:api": "turbo dev --filter=@crm/api",
    "dev:worker": "turbo dev --filter=@crm/worker",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @crm/api db:generate",
    "db:migrate": "pnpm --filter @crm/api db:migrate",
    "db:push": "pnpm --filter @crm/api db:push"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  }
}
