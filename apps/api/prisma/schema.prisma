generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum MemberStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum Department {
  SALES
  MARKETING
  MANAGEMENT
  OTHER
}

enum Plan {
  FREE
  STARTER
  GROWTH
}

enum ContactSource {
  REFERRAL
  WEBSITE
  COLD_OUTREACH
  EVENT
  SOCIAL
  PARTNER
  OTHER
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  STATUS_CHANGE
}

enum TaskStatus {
  OPEN
  DONE
}

enum LostReason {
  PRICE
  TIMING
  COMPETITOR
  NO_BUDGET
  GHOSTED
  OTHER
}

enum ProbabilitySource {
  STAGE_DEFAULT
  MANUAL
}

enum NotificationType {
  LEAD_ASSIGNED
  DEAL_STAGE_CHANGED
  DEAL_ASSIGNED
  DEAL_WON
  DEAL_LOST
  FOLLOW_UP_OVERDUE
  TASK_ASSIGNED
  TASK_REMINDER
  PROPOSAL_ACCEPTED
  PAYMENT_RECEIVED
  TEAM_MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_STATUS_CHANGED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_PAST_DUE
  PAYMENT_FAILED
  INVOICE_AVAILABLE
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  FAILED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum AuditAction {
  USER_INVITED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  USER_REACTIVATED
  RECORD_DELETED
  DEAL_ASSIGNED
  PIPELINE_CHANGED
  BILLING_CHANGED
  BILLING_CHECKOUT_CREATED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_REACTIVATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  INVOICE_PAID
  INVOICE_FAILED
  ORGANIZATION_UPDATED
  PERMISSION_CHANGED
  INVITATION_RESENT
  INVITATION_CANCELLED
  MEMBER_JOINED
  MEMBER_DEPARTMENT_CHANGED
  OWNERSHIP_TRANSFERRED
  COMPANY_CREATED
  COMPANY_UPDATED
  COMPANY_DELETED
  COMPANY_OWNER_CHANGED
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED
  CONTACT_OWNER_CHANGED
  DEAL_CREATED
  DEAL_UPDATED
  DEAL_DELETED
  DEAL_OWNER_CHANGED
  DEAL_STAGE_CHANGED
  DEAL_WON
  DEAL_LOST
  DEAL_REOPENED
  DEAL_PROBABILITY_CHANGED
  ACTIVITY_CREATED
  ACTIVITY_UPDATED
  ACTIVITY_DELETED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_ASSIGNED
  TASK_DELETED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// --- Identity ---

/// App user. `id` is the Supabase `auth.users.id`. No local passwords.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships         OrganizationMember[]
  invitedMembers      OrganizationMember[] @relation("MemberInviter")
  invitationsSent     OrganizationInvitation[] @relation("InvitationInviter")
  ownedCompanies      Company[]            @relation("CompanyOwner")
  ownedContacts       Contact[]            @relation("ContactOwner")
  ownedDeals          Deal[]               @relation("DealOwner")
  dealStageChanges    DealStageHistory[]   @relation("DealStageChanger")
  authoredActivities  Activity[]           @relation("ActivityAuthor")
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  notifications       Notification[]
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      Plan     @default(FREE)
  timezone  String   @default("UTC")
  currency  String   @default("USD") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members        OrganizationMember[]
  invitations    OrganizationInvitation[]
  companies      Company[]
  contacts       Contact[]
  pipelines      Pipeline[]
  pipelineStages PipelineStage[]
  deals          Deal[]
  dealStageHistory DealStageHistory[]
  activities     Activity[]
  tasks          Task[]
  notifications    Notification[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  paymentEvents    PaymentEvent[]
  billingCheckouts BillingCheckout[]
  auditLogs        AuditLog[]
  jobs             Job[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           Role         @default(MEMBER)
  department     Department?
  invitedById    String?      @map("invited_by") @db.Uuid
  status         MemberStatus @default(INVITED)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("MemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, role])
  @@index([organizationId, department])
  @@map("organization_members")
}

/// Pending/historical org invites. Only `token_hash` is stored — never the raw token.
model OrganizationInvitation {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  email          String
  role           Role        @default(MEMBER)
  department     Department?
  tokenHash      String      @unique @map("token_hash")
  expiresAt      DateTime    @map("expires_at")
  acceptedAt     DateTime?   @map("accepted_at")
  cancelledAt    DateTime?   @map("cancelled_at")
  invitedById    String      @map("invited_by") @db.Uuid
  lastSentAt     DateTime    @default(now()) @map("last_sent_at")
  sendCount      Int         @default(1) @map("send_count")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
  @@map("organization_invitations")
}

// --- CRM ---

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  industry       String?
  employeeCount  Int?     @map("employee_count")
  website        String?
  ownerId        String?  @map("owner_id") @db.Uuid
  tags           String[] @default([])
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]
  tasks        Task[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, ownerId])
  @@index([organizationId, industry])
  @@index([organizationId, createdAt])
  @@map("companies")
}

model Contact {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String?
  phone          String?
  jobTitle       String?        @map("job_title")
  companyId      String?        @map("company_id") @db.Uuid
  industry       String?
  source         ContactSource?
  ownerId        String         @map("owner_id") @db.Uuid
  tags           String[]       @default([])
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner          User         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  primaryDeals   Deal[]       @relation("DealPrimaryContact")
  activities     Activity[]
  tasks          Task[]

  @@unique([organizationId, email])
  @@index([organizationId, ownerId])
  @@index([organizationId, companyId])
  @@index([organizationId, source])
  @@index([organizationId, createdAt])
  @@map("contacts")
}

model Pipeline {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @default("Sales")
  description    String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isDefault])
  @@map("pipelines")
}

model PipelineStage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pipelineId     String   @map("pipeline_id") @db.Uuid
  name           String
  key            String?
  order          Int
  probability    Int      @default(0)
  isWon          Boolean  @default(false) @map("is_won")
  isLost         Boolean  @default(false) @map("is_lost")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline       Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals          Deal[]
  historyFrom    DealStageHistory[] @relation("StageHistoryFrom")
  historyTo      DealStageHistory[] @relation("StageHistoryTo")

  @@unique([pipelineId, name])
  @@unique([pipelineId, order])
  @@index([organizationId, pipelineId])
  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

/// Unified pipeline record. "Lead" is the first stage, not a separate entity.
model Deal {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  name              String
  description       String?
  companyId         String             @map("company_id") @db.Uuid
  primaryContactId  String             @map("primary_contact_id") @db.Uuid
  pipelineId        String             @map("pipeline_id") @db.Uuid
  stageId           String             @map("stage_id") @db.Uuid
  ownerId           String             @map("owner_id") @db.Uuid
  amount            Decimal?           @db.Decimal(14, 2)
  currency          String             @default("USD") @db.Char(3)
  expectedCloseDate DateTime?          @map("expected_close_date") @db.Date
  probability       Int?
  probabilitySource ProbabilitySource? @map("probability_source")
  lostReason        LostReason?        @map("lost_reason")
  lostReasonNote    String?            @map("lost_reason_note")
  wonAt             DateTime?          @map("won_at")
  lostAt            DateTime?          @map("lost_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryContact Contact            @relation("DealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: Restrict)
  pipeline       Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage          PipelineStage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner          User               @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activities     Activity[]
  tasks          Task[]
  stageHistory   DealStageHistory[]

  @@index([organizationId])
  @@index([organizationId, pipelineId])
  @@index([organizationId, stageId])
  @@index([organizationId, ownerId])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, companyId])
  @@index([organizationId, createdAt])
  @@index([organizationId, updatedAt])
  @@index([organizationId, wonAt])
  @@index([organizationId, lostAt])
  @@map("deals")
}

model DealStageHistory {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  dealId          String   @map("deal_id") @db.Uuid
  fromStageId     String?  @map("from_stage_id") @db.Uuid
  toStageId       String   @map("to_stage_id") @db.Uuid
  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime @default(now()) @map("changed_at")
  fromProbability Int?     @map("from_probability")
  toProbability   Int?     @map("to_probability")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage    PipelineStage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage      PipelineStage @relation("StageHistoryTo", fields: [toStageId], references: [id], onDelete: Restrict)
  changedBy    User          @relation("DealStageChanger", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, dealId])
  @@index([dealId, changedAt])
  @@map("deal_stage_history")
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           ActivityType
  authorId       String       @map("author_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  contactId      String?      @map("contact_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  content        String?
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, dealId])
  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@index([organizationId, authorId])
  @@map("activities")
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  title          String
  description    String?
  assigneeId     String     @map("assignee_id") @db.Uuid
  createdById    String     @map("created_by") @db.Uuid
  companyId      String?    @map("company_id") @db.Uuid
  contactId      String?    @map("contact_id") @db.Uuid
  dealId         String?    @map("deal_id") @db.Uuid
  dueDate        DateTime?  @map("due_date")
  completedAt    DateTime?  @map("completed_at")
  status         TaskStatus @default(OPEN)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creator      User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId, assigneeId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, dealId])
  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@index([organizationId, status])
  @@index([organizationId, status, dueDate])
  @@index([status, dueDate])
  @@map("tasks")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String?
  message        String?
  entityType     String?          @map("entity_type")
  entityId       String?          @map("entity_id")
  payload        Json
  dedupeKey      String?          @unique @map("dedupe_key")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// --- Billing ---

/// Catalog of sellable plans. Provider price IDs are configuration, not client input.
model BillingPlan {
  id                   String   @id @default(uuid()) @db.Uuid
  key                  String   @unique
  name                 String
  description          String?
  active               Boolean  @default(true)
  currency             String   @db.Char(3)
  monthlyPrice         Decimal  @map("monthly_price") @db.Decimal(14, 2)
  yearlyPrice          Decimal  @map("yearly_price") @db.Decimal(14, 2)
  stripePriceIdMonth   String?  @map("stripe_price_id_month")
  stripePriceIdYear    String?  @map("stripe_price_id_year")
  razorpayPlanIdMonth  String?  @map("razorpay_plan_id_month")
  razorpayPlanIdYear   String?  @map("razorpay_plan_id_year")
  features             String[] @default([])
  entitlement          Plan     @default(STARTER)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@index([active])
  @@map("billing_plans")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  planId                 String?            @map("plan_id") @db.Uuid
  provider               PaymentProvider
  providerCustomerId     String             @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  status                 SubscriptionStatus @default(INCOMPLETE)
  amount                 Decimal?           @db.Decimal(14, 2)
  currency               String             @default("USD") @db.Char(3)
  billingInterval        BillingInterval    @default(MONTH) @map("billing_interval")
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  trialStart             DateTime?          @map("trial_start")
  trialEnd               DateTime?          @map("trial_end")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         BillingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  invoices     Invoice[]
  paymentEvents PaymentEvent[]

  @@unique([provider, providerSubscriptionId])
  @@index([organizationId, status])
  @@index([provider, providerCustomerId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Invoice {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  subscriptionId    String?         @map("subscription_id") @db.Uuid
  provider          PaymentProvider
  providerInvoiceId String          @map("provider_invoice_id")
  invoiceNumber     String?         @map("invoice_number")
  amount            Decimal         @db.Decimal(14, 2)
  currency          String          @db.Char(3)
  status            InvoiceStatus
  invoiceUrl        String?         @map("invoice_url")
  pdfUrl            String?         @map("pdf_url")
  periodStart       DateTime?       @map("period_start")
  periodEnd         DateTime?       @map("period_end")
  dueAt             DateTime?       @map("due_at")
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentEvents PaymentEvent[]

  @@unique([provider, providerInvoiceId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([subscriptionId])
  @@map("invoices")
}

/// Provider webhooks. Unique (provider, provider_event_id) makes delivery idempotent.
model PaymentEvent {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String?            @map("organization_id") @db.Uuid
  subscriptionId  String?            @map("subscription_id") @db.Uuid
  invoiceId       String?            @map("invoice_id") @db.Uuid
  provider        PaymentProvider
  providerEventId String             @map("provider_event_id")
  eventType       String             @map("event_type")
  payload         Json
  payloadHash     String?            @map("payload_hash")
  status          PaymentEventStatus @default(RECEIVED)
  processedAt     DateTime?          @map("processed_at")
  failedAt        DateTime?          @map("failed_at")
  attempts        Int                @default(0)
  lastError       String?            @map("last_error")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([organizationId, createdAt])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@map("payment_events")
}

model BillingCheckout {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  idempotencyKey  String          @map("idempotency_key")
  provider        PaymentProvider
  planId          String          @map("plan_id") @db.Uuid
  billingInterval BillingInterval @map("billing_interval")
  status          String          @default("CREATED")
  checkoutUrl     String?         @map("checkout_url")
  sessionId       String?         @map("session_id")
  response        Json
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@map("billing_checkouts")
}

// --- Platform ---

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  actorId        String?     @map("actor_id") @db.Uuid
  action         AuditAction
  entityType     String      @map("entity_type")
  entityId       String      @map("entity_id")
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, actorId])
  @@index([organizationId, action])
  @@map("audit_logs")
}

/// Postgres-backed job queue. The Go worker claims rows with SKIP LOCKED.
model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  type           String
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  availableAt    DateTime  @default(now()) @map("available_at")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  processedAt    DateTime? @map("processed_at")
  failedAt       DateTime? @map("failed_at")
  requestId      String?   @map("request_id")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organizationId, status])
  @@index([status, lockedAt])
  @@index([status, processedAt])
  @@index([createdAt])
  @@map("jobs")
}
