generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum MemberStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum Department {
  SALES
  MARKETING
  MANAGEMENT
  OTHER
}

enum Plan {
  FREE
  STARTER
  GROWTH
}

enum ContactSource {
  REFERRAL
  WEBSITE
  COLD_OUTREACH
  EVENT
  OTHER
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  STATUS_CHANGE
}

enum TaskStatus {
  OPEN
  DONE
}

enum LostReason {
  PRICE
  TIMING
  COMPETITOR
  NO_BUDGET
  GHOSTED
  OTHER
}

enum NotificationType {
  LEAD_ASSIGNED
  DEAL_STAGE_CHANGED
  FOLLOW_UP_OVERDUE
  TASK_ASSIGNED
  PROPOSAL_ACCEPTED
  PAYMENT_RECEIVED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum AuditAction {
  USER_INVITED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  RECORD_DELETED
  BILLING_CHECKOUT_CREATED
  SUBSCRIPTION_UPDATED
  ORGANIZATION_UPDATED
  PERMISSION_CHANGED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// --- Identity ---

/// App user. `id` is the Supabase `auth.users.id`. No local passwords.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships         OrganizationMember[]
  invitedMembers      OrganizationMember[] @relation("MemberInviter")
  ownedCompanies      Company[]            @relation("CompanyOwner")
  ownedContacts       Contact[]            @relation("ContactOwner")
  ownedDeals          Deal[]               @relation("DealOwner")
  authoredActivities  Activity[]           @relation("ActivityAuthor")
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  notifications       Notification[]
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      Plan     @default(FREE)
  timezone  String   @default("UTC")
  currency  String   @default("USD") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members        OrganizationMember[]
  companies      Company[]
  contacts       Contact[]
  pipelines      Pipeline[]
  pipelineStages PipelineStage[]
  deals          Deal[]
  activities     Activity[]
  tasks          Task[]
  notifications  Notification[]
  subscription   Subscription?
  invoices       Invoice[]
  paymentEvents  PaymentEvent[]
  auditLogs      AuditLog[]
  jobs           Job[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           Role         @default(MEMBER)
  department     Department?
  invitedById    String?      @map("invited_by") @db.Uuid
  status         MemberStatus @default(INVITED)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("MemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, role])
  @@map("organization_members")
}

// --- CRM ---

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  industry       String?
  employeeCount  Int?     @map("employee_count")
  website        String?
  ownerId        String?  @map("owner_id") @db.Uuid
  tags           String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]
  tasks        Task[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, ownerId])
  @@map("companies")
}

model Contact {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String?
  phone          String?
  jobTitle       String?        @map("job_title")
  companyId      String?        @map("company_id") @db.Uuid
  industry       String?
  source         ContactSource?
  ownerId        String         @map("owner_id") @db.Uuid
  tags           String[]       @default([])
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner          User         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  primaryDeals   Deal[]       @relation("DealPrimaryContact")
  activities     Activity[]
  tasks          Task[]

  @@unique([organizationId, email])
  @@index([organizationId, ownerId])
  @@index([organizationId, companyId])
  @@map("contacts")
}

model Pipeline {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @default("Sales")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("pipelines")
}

model PipelineStage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pipelineId     String   @map("pipeline_id") @db.Uuid
  name           String
  order          Int
  isWon          Boolean  @default(false) @map("is_won")
  isLost         Boolean  @default(false) @map("is_lost")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@unique([pipelineId, name])
  @@unique([pipelineId, order])
  @@index([organizationId, pipelineId])
  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

/// Unified pipeline record. "Lead" is the first stage, not a separate entity.
model Deal {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  name              String
  companyId         String      @map("company_id") @db.Uuid
  primaryContactId  String      @map("primary_contact_id") @db.Uuid
  pipelineId        String      @map("pipeline_id") @db.Uuid
  stageId           String      @map("stage_id") @db.Uuid
  ownerId           String      @map("owner_id") @db.Uuid
  amount            Decimal?    @db.Decimal(14, 2)
  currency          String      @default("USD") @db.Char(3)
  expectedCloseDate DateTime?   @map("expected_close_date") @db.Date
  probability       Int?
  lostReason        LostReason? @map("lost_reason")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryContact Contact       @relation("DealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: Restrict)
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage          PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner          User          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activities     Activity[]
  tasks          Task[]

  @@index([organizationId])
  @@index([organizationId, stageId])
  @@index([organizationId, ownerId])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, companyId])
  @@map("deals")
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           ActivityType
  authorId       String       @map("author_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  contactId      String?      @map("contact_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  content        String?
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, dealId])
  @@index([organizationId, contactId])
  @@index([organizationId, companyId])
  @@map("activities")
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  title          String
  assigneeId     String     @map("assignee_id") @db.Uuid
  createdById    String     @map("created_by") @db.Uuid
  companyId      String?    @map("company_id") @db.Uuid
  contactId      String?    @map("contact_id") @db.Uuid
  dealId         String?    @map("deal_id") @db.Uuid
  dueDate        DateTime?  @map("due_date") @db.Date
  status         TaskStatus @default(OPEN)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creator      User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId, assigneeId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, dealId])
  @@map("tasks")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  payload        Json
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// --- Billing ---

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @unique @map("organization_id") @db.Uuid
  provider               PaymentProvider
  providerCustomerId     String             @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  status                 SubscriptionStatus @default(INCOMPLETE)
  amount                 Decimal?           @db.Decimal(14, 2)
  currency               String             @default("USD") @db.Char(3)
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([provider, providerCustomerId])
  @@map("subscriptions")
}

model Invoice {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  provider          PaymentProvider
  providerInvoiceId String          @map("provider_invoice_id")
  amount            Decimal         @db.Decimal(14, 2)
  currency          String          @db.Char(3)
  status            InvoiceStatus
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerInvoiceId])
  @@index([organizationId, status])
  @@map("invoices")
}

/// Provider webhooks. Unique (provider, provider_event_id) makes delivery idempotent.
model PaymentEvent {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  provider        PaymentProvider
  providerEventId String          @map("provider_event_id")
  eventType       String          @map("event_type")
  payload         Json
  processedAt     DateTime?       @map("processed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([organizationId, createdAt])
  @@map("payment_events")
}

// --- Platform ---

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  actorId        String?     @map("actor_id") @db.Uuid
  action         AuditAction
  entityType     String      @map("entity_type")
  entityId       String      @map("entity_id")
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, actorId])
  @@index([organizationId, action])
  @@map("audit_logs")
}

/// Postgres-backed job queue. The Go worker claims rows with SKIP LOCKED.
model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  type           String
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  processedAt    DateTime? @map("processed_at")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organizationId, status])
  @@map("jobs")
}
